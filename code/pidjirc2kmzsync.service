# pidjirc2kmzsync.service
# ------------------------
# A user-level systemd unit (not a system-level one) -- deliberately, so
# no sudo/root access is ever needed to install, update, or restart the
# service. The one-time cost is enabling "lingering" for this user (see
# setup below), which lets systemd start user units at boot even before
# any interactive login.
#
# One-time setup on the Pi:
#     mkdir -p ~/.config/systemd/user
#     cp ~/PiDjiRc2KmzSync/pidjirc2kmzsync.service ~/.config/systemd/user/
#     systemctl --user daemon-reload
#     systemctl --user enable --now pidjirc2kmzsync
#     sudo loginctl enable-linger mark   # one-time, needs sudo just this once
#
# After that, deploy.sh's `systemctl --user restart pidjirc2kmzsync`
# needs no sudo at all, and the service comes up automatically on every
# reboot without an interactive SSH session.
#
# One worker process (only one process may hold the MTP/USB session), but 16
# threads inside it, so a slow MTP operation can't stop /api/ping answering.
# MTP calls themselves are still serialized by the backend's session lock.
#
# Day to day:
#     systemctl --user status pidjirc2kmzsync
#     journalctl --user -u pidjirc2kmzsync -f
#     systemctl --user restart pidjirc2kmzsync

[Unit]
Description=PiDjiRc2KmzSync relay (Flask + gunicorn)
After=network.target

[Service]
WorkingDirectory=%h/PiDjiRc2KmzSync
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/PiDjiRc2KmzSync/.venv/bin/gunicorn -w 1 --threads 16 -b 0.0.0.0:8000 "flask_app.app:create_app()"
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
